# ==============================================================================
# sAI Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.template .env
# 2. Update the variable values below with your credentials.
#
# DO NOT commit the actual '.env' file containing your secrets to version control.
# ==============================================================================

# NVIDIA API Configuration (Required for Phase 1 LLMs)
# Get your API key from NVIDIA NIM: https://build.nvidia.com/
NVIDIA_API_KEY="your_nvidia_api_key_here"

# Optional: Default NVIDIA API Base URL (if custom hosting or proxying)
# NVIDIA_API_BASE_URL="https://integrate.api.nvidia.com/v1"

# Environment Setting (development / production)
SAI_ENV="development"

# Port / Hosting configuration (for future web UI integration)
SAI_PORT=8000
SAI_HOST="127.0.0.1"

# OpenRouter API Configuration (active default provider)
# Get your API key from https://openrouter.ai/keys
# OPENROUTER_API_KEY=""

# Future Providers Configuration (for Phase 2+)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
